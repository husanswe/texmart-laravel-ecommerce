# Copy to .env and adjust.
#
# With mocks on, the app serves everything from app/data/*.json and never
# makes a network request. Turn them off once the Laravel API is running:
#
#   NUXT_PUBLIC_USE_MOCKS=false
#   NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
#
# Nothing in the UI changes — only the repositories switch branch.

NUXT_PUBLIC_USE_MOCKS=true
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
